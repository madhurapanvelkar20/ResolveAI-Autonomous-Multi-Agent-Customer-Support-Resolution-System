
APP_NAME=ResolveAI
APP_VERSION=0.1.0
ENVIRONMENT=development

LLM_PROVIDER_ORDER=groq,gemini,ollama

GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OLLAMA_BASE_URL=http://localhost:11434/v1

GROQ_MODEL=
GEMINI_MODEL=
OLLAMA_MODEL=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

MAX_ITERATIONS=12
MAX_TOOL_CALLS=20
MAX_CASE_WALL_TIME_SECONDS=120
MAX_REFUND_AMOUNT=1000.00

TRACE_DIR=traces
TOOL_TRANSPORT=direct

DATABASE_PATH=data/resolveai.db
CHROMA_DIR=data/chroma
